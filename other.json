{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default Renovate config tuned for current Renovate best practices and low-noise automation.",

  "extends": [
    "config:best-practices",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "group:monorepos"
  ],

  "timezone": "Europe/Oslo",

  "assignees": ["{{arg0}}"],
  "labels": ["dependencies"],
  "platformCommit": "auto",
  "platformAutomerge": true,
  "rangeStrategy": "auto",
  "transitiveRemediation": true,
  "pinDigests": true,

  "prHourlyLimit": 2,
  "prConcurrentLimit": 0,
  "prCreation": "immediate",
  "prFooter": null,
  "rebaseWhen": "behind-base-branch",
  "recreateWhen": "auto",

  "dependencyDashboard": true,
  "dependencyDashboardHeader": "![](https://i.imgur.com/kX4uzqH.gif)",
  "dependencyDashboardLabels": ["dependencies"],

  "lockFileMaintenance": {
    "enabled": true,
    "assignees": ["{{arg0}}"],
    "schedule": ["before 5am on the first day of the month"],
    "extends": ["github>promise/renovate-config:automerge"]
  },

  "rebaseStalePrs": true,
  "semanticCommits": "enabled",

  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "rangeStrategy": "update-lockfile"
  },

  "git-submodules": {
    "enabled": true
  },

  "packageRules": [
    {
      "description": "Automerge dependencies with built-in type definitions",
      "matchPackageNames": ["discord.js", "@types/node", "typescript", "@total-typescript/ts-reset", "winston", "match-sorter", "@cloudflare/workers-types", "@tsndr/cloudflare-worker-jwt"],
      "extends": ["github>promise/renovate-config:automerge"]
    },
    {
      "description": "Automerge low-risk patch and digest updates",
      "matchUpdateTypes": ["patch", "pin", "pinDigest", "digest", "rollback", "bump"],
      "extends": ["github>promise/renovate-config:automerge"]
    },
    {
      "description": "Automerge linting and testing dependency upgrades",
      "extends": ["packages:linters", "packages:test", "github>promise/renovate-config:automerge"]
    },
    {
      "description": "Group Docusaurus dependencies",
      "matchPackagePrefixes": ["@docusaurus/"],
      "groupName": "Docusaurus",
      "pin": { "groupName": "Pin Dependencies", "groupSlug": "pin-dependencies" }
    },
    {
      "description": "Group React dependencies",
      "matchPackagePrefixes": ["react", "@types/react"],
      "groupName": "React",
      "pin": { "groupName": "Pin Dependencies", "groupSlug": "pin-dependencies" }
    },
    {
      "description": "Group linting dependencies",
      "matchPackageNames": ["eslint-config-promise", "promise/eslint-config"],
      "extends": ["packages:linters"],
      "groupName": "linting",
      "pin": { "groupName": "Pin Dependencies", "groupSlug": "pin-dependencies" }
    },
    {
      "description": "Group testing dependencies",
      "extends": ["packages:test"],
      "groupName": "testing",
      "pin": { "groupName": "Pin Dependencies", "groupSlug": "pin-dependencies" }
    },
    {
      "description": "Group mongoose with typegoose",
      "matchPackageNames": ["mongoose", "@typegoose/typegoose"],
      "groupName": "mongoose",
      "pin": { "groupName": "Pin Dependencies", "groupSlug": "pin-dependencies" }
    },
    {
      "description": "Avoid pinning peer dependencies",
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Automerge node version",
      "matchManagers": ["nvm"],
      "extends": ["github>promise/renovate-config:automerge"]
    },
    {
      "description": "Automerge pnpm updates",
      "matchPackageNames": ["pnpm"],
      "extends": ["github>promise/renovate-config:automerge"]
    },
    {
      "description": "Group Python docker tags and dependency (1/2)",
      "matchPackageNames": ["python"],
      "groupName": "python",
      "pin": { "groupName": "Pin Dependencies", "groupSlug": "pin-dependencies" },
      "extends": ["github>promise/renovate-config:automerge"]
    },
    {
      "description": "Group Python docker tags and dependency (2/2)",
      "matchDepNames": ["python"],
      "groupName": "python",
      "pin": { "groupName": "Pin Dependencies", "groupSlug": "pin-dependencies" },
      "extends": ["github>promise/renovate-config:automerge"]
    },
    {
      "description": "Group @remix-run dependencies",
      "matchPackagePrefixes": ["@remix-run/"],
      "groupName": "remix-run",
      "pin": { "groupName": "Pin Dependencies", "groupSlug": "pin-dependencies" },
      "extends": ["github>promise/renovate-config:automerge"]
    },
    {
      "description": "Group express with types",
      "matchPackageNames": ["express", "@types/express"],
      "groupName": "express",
      "pin": { "groupName": "Pin Dependencies", "groupSlug": "pin-dependencies" }
    }
  ]
}
